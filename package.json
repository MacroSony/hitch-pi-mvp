{
  "name": "hitch-pi-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-sandbox.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test dist/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "acceptance:deterministic": "npm run check",
    "acceptance:host": "npm run build && HITCH_RUN_SANDBOX_TESTS=1 node --disable-warning=ExperimentalWarning --test dist/test/native-runtime.test.js",
    "acceptance:service": "npm run build && node scripts/run-service-acceptance.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "wechat:login": "node --disable-warning=ExperimentalWarning dist/src/wechat-login.js"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "wechat-ilink-client": "0.1.0"
  }
}
