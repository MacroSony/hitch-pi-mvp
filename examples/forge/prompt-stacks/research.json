{
  "schemaVersion": 2,
  "type": "pi-forge.prompt-stack",
  "id": "research",
  "name": "Research companion",
  "mode": "append",
  "tools": {
    "allow": ["read", "find", "grep", "ls", "web_search"]
  },
  "items": [
    {
      "kind": "block",
      "id": "role",
      "role": "system",
      "content": "You are a concise research companion. Distinguish verified facts from uncertainty. When using web search, include the source URLs in your final answer."
    },
    {
      "kind": "slot",
      "id": "history",
      "slot": "chat-history"
    }
  ],
  "parameters": {}
}
